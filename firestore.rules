// Cole em: Console Firebase → Firestore Database → Regras → Publicar
// A escrita é restrita ao e-mail do admin criado em Authentication.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /site/main {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.token.email == "fabriciocpacheco@gmail.com"
                   && request.auth.token.email_verified == true;
    }
  }
}
