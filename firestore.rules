// Cole em: Console Firebase → Firestore Database → Regras → Publicar
// Troque SEU_EMAIL_AQUI pelo e-mail do usuário criado em Authentication.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /site/main {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.token.email == "SEU_EMAIL_AQUI"
                   && request.auth.token.email_verified == true;
    }
  }
}
